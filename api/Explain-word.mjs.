// api/explain-word.mjs
export default async function handler(req, res) {
  if (req.method !== "POST") return res.status(405).json({ error: "POST only" });
  const key = process.env.DEEPSEEK_API_KEY;
  if (!key) return res.status(500).json({ error: "DEEPSEEK_API_KEY not set" });

  const { word } = req.body || {};
  if (!word) return res.status(400).json({ error: "Word required" });

  const system = "You are an expert Australian English spelling teacher. You only output valid JSON.";
  const user = `For the word "${word}", provide a very short explanation of its spelling rule or etymology, and a catchy mnemonic (memory trick) to remember it.
Strictly use Australian English conventions (e.g., -ise, -our, -re).
Format exactly as: {"rule": "Short explanation...", "mnemonic": "Memory trick..."}`;

  try {
    const r = await fetch("https://api.deepseek.com/chat/completions", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Authorization": `Bearer ${key}` },
      body: JSON.stringify({
        model: "deepseek-chat",
        messages: [{ role: "system", content: system }, { role: "user", content: user }],
        response_format: { type: "json_object" },
        temperature: 0.7,
        max_tokens: 150,
      }),
    });

    if (!r.ok) throw new Error("DeepSeek API error");
    const data = await r.json();
    const content = data.choices[0].message.content;
    const parsed = JSON.parse(content);
    return res.status(200).json(parsed);
  } catch (e) {
    return res.status(500).json({ error: "Failed to generate explanation", rule: "This is a commonly misspelled word.", mnemonic: "Break it into smaller chunks to remember it." });
  }
}
